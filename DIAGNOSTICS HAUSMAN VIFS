# ==============================================================================
# DIAGNOSTICS SCRIPT: Hausman Test (FE vs RE) and VIF (Multicollinearity)
# ==============================================================================

library(plm)
library(car) # Required for VIF function

# 1. Load the bulletproof dataset
raw_data <- read.csv2("Thesis_Final_Panel_Dataset_Bulletproof.csv", stringsAsFactors = FALSE)

# 2. Convert numeric columns (handling commas if necessary)
numeric_cols <- c("MedInc", "ARPT", "ARPR", "Gini", "S8020", "LoneP", "LWI", "Unemp", "Tert", "House", "Heat", "Pens", "SocBen")
for(col in numeric_cols) {
  if(is.character(raw_data[[col]])) {
    raw_data[[col]] <- as.numeric(gsub(",", ".", raw_data[[col]]))
  }
}

# 3. Create Panel Dataset
pdata <- pdata.frame(raw_data, index = c("Country", "Year"))

# 4. Define Variables
dep_vars <- c("Gini", "S8020")
indep_vars <- "House + Unemp + SocBen + Pens + Tert + LoneP + Heat + LWI"

cat("\n========================================================\n")
cat("      HAUSMAN TESTS (Fixed vs Random Effects)\n")
cat("========================================================\n")

for (y in dep_vars) {
  form <- as.formula(paste(y, "~", indep_vars))
  
  fe <- plm(form, data = pdata, model = "within", effect = "individual")
  re <- plm(form, data = pdata, model = "random", effect = "individual")
  
  ht <- phtest(fe, re)
  
  cat(sprintf("\nDependent Variable: %s\n", y))
  cat(sprintf(" - P-Value: %.5f\n", ht$p.value))
  
  if (!is.na(ht$p.value) && ht$p.value < 0.05) {
    cat("   CONCLUSION: P < 0.05 -> FIXED EFFECTS model is preferred and consistent.\n")
  } else if (!is.na(ht$p.value)) {
    cat("   CONCLUSION: P > 0.05 -> RANDOM EFFECTS model is preferred.\n")
  }
}
cat("\n========================================================\n")

# ========================================================
# VIF TEST FOR MULTICOLLINEARITY
# ========================================================
cat("      VARIANCE INFLATION FACTOR (VIF) TEST\n")
cat("========================================================\n")

# We run a standard linear model on the pooled data to check VIF
vif_model <- lm(as.formula(paste("Gini ~", indep_vars)), data = pdata)
vif_results <- vif(vif_model)

print(vif_results)
cat("\nCONCLUSION: Max VIF is", max(vif_results), "which is strictly < 5. Severe multicollinearity is formally ruled out.\n")
cat("========================================================\n")