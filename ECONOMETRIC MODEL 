# ==============================================================================
# ECONOMETRIC ANALYSIS SCRIPT: Lagged Fixed-Effects, Arellano SEs & Table Export
# ==============================================================================

library(plm)
library(lmtest)
library(sandwich)
library(stargazer)

# 1. Load dataset and create panel object
raw_data <- read.csv2("Thesis_Final_Panel_Dataset_Bulletproof.csv", stringsAsFactors = FALSE)

numeric_cols <- c("MedInc", "ARPT", "ARPR", "Gini", "S8020", "LoneP", "LWI", "Unemp", "Tert", "House", "Heat", "Pens", "SocBen")
for(col in numeric_cols) {
  if(is.character(raw_data[[col]])) {
    raw_data[[col]] <- as.numeric(gsub(",", ".", raw_data[[col]]))
  }
}
pdata <- pdata.frame(raw_data, index = c("Country", "Year"))

# 2. Estimate Fixed Effects models (1-year lagged independent variables)
fe_s8020 <- plm(S8020 ~ lag(House, 1) + lag(Unemp, 1) + lag(SocBen, 1) + lag(Pens, 1) + 
                  lag(Tert, 1) + lag(LoneP, 1) + lag(Heat, 1) + lag(LWI, 1), 
                data = pdata, model = "within", effect = "individual")

fe_gini <- plm(Gini ~ lag(House, 1) + lag(Unemp, 1) + lag(SocBen, 1) + lag(Pens, 1) + 
                 lag(Tert, 1) + lag(LoneP, 1) + lag(Heat, 1) + lag(LWI, 1), 
               data = pdata, model = "within", effect = "individual")

# 3. Calculate Arellano Clustered Standard Errors and P-values
cov_s8020 <- vcovHC(fe_s8020, type = "HC1", cluster = "group")
cov_gini  <- vcovHC(fe_gini, type = "HC1", cluster = "group")

se_s8020  <- sqrt(diag(cov_s8020))
se_gini   <- sqrt(diag(cov_gini))

p_s8020   <- coeftest(fe_s8020, vcov = cov_s8020)[, 4]
p_gini    <- coeftest(fe_gini, vcov = cov_gini)[, 4]

# 4. Export Table 2 using Stargazer (Labels ordered strictly to match plm formula)
stargazer(fe_s8020, fe_gini,
          type = "html", 
          out = "Table2_Final_Results.doc",
          se = list(se_s8020, se_gini),
          p = list(p_s8020, p_gini),
          title = "Table 2: Country Fixed Effects with Temporally Lagged Independent Variables (t-1)",
          dep.var.labels = c("S80/S20 Ratio", "Gini Coefficient"),
          covariate.labels = c("Housing Cost Overburden (t-1)",
                               "Unemployment Rate (t-1)",
                               "Social Benefits (t-1)",
                               "Pensions (t-1)",
                               "Tertiary Education (t-1)",
                               "Lone-Parent Households (t-1)",
                               "Heating Deprivation (t-1)",
                               "Low Work Intensity (t-1)"),
          model.names = FALSE,
          keep.stat = c("n", "rsq"),
          notes = "Note: Arellano robust standard errors clustered at the country level are reported in parentheses. *p < 0.10, **p < 0.05, ***p < 0.01.",
          no.space = TRUE)

cat("\n========================================================\n")
cat(" SUCCESS: Table 2 exported successfully to Table2_Final_Results.doc\n")
cat("========================================================\n")