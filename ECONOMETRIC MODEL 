# ECONOMETRIC ANALYSIS SCRIPT: Lagged Fixed-Effects with Arellano SEs
# ==============================================================================

library(lmtest)
library(plm)

# 1. FINAL MODEL FOR GINI (With a 1-year lag for all independent variables)
fe_gini <- plm(Gini ~ lag(House, 1) + lag(Unemp, 1) + lag(SocBen, 1) + lag(Pens, 1) + 
                 lag(Tert, 1) + lag(LoneP, 1) + lag(Heat, 1) + lag(LWI, 1), 
               data = pdata, model = "within", effect = "individual")

# Apply Arellano clustered standard errors (robust to heteroskedasticity and serial correlation)
final_gini <- coeftest(fe_gini, vcov = vcovHC(fe_gini, method = "arellano", cluster = "group"))

cat("\n========================================================\n")
cat("      FINAL REGRESSION RESULTS: GINI (LAGGED FIXED EFFECTS)\n")
cat("========================================================\n")
print(final_gini)

cat("\n--- Within R-Squared for the GINI model ---\n")
print(summary(fe_gini)$r.squared)


# 2. FINAL MODEL FOR S80/20 (With a 1-year lag for all independent variables)
fe_s8020 <- plm(S8020 ~ lag(House, 1) + lag(Unemp, 1) + lag(SocBen, 1) + lag(Pens, 1) + 
                  lag(Tert, 1) + lag(LoneP, 1) + lag(Heat, 1) + lag(LWI, 1), 
                data = pdata, model = "within", effect = "individual")

# Apply Arellano clustered standard errors
final_s8020 <- coeftest(fe_s8020, vcov = vcovHC(fe_s8020, method = "arellano", cluster = "group"))

cat("\n========================================================\n")
cat("      FINAL REGRESSION RESULTS: S8020 (LAGGED FIXED EFFECTS)\n")
cat("========================================================\n")
