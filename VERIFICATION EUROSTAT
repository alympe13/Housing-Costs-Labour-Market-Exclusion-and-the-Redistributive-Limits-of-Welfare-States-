# ==============================================================================
# VALIDATION SCRIPT: Comparison of Variables with Official Eurostat Data
# ==============================================================================

# Install if not available: install.packages("eurostat")
library(eurostat)
library(dplyr)
library(tidyr)

cat("Loading our custom Panel Dataset...\n")
my_data <- read.csv2("Thesis_Final_Panel_Dataset_Bulletproof.csv")

# Ensure countries have the same coding
my_data <- my_data %>%
  mutate(Country = case_when(
    Country == "GR" ~ "EL",
    Country == "GB" ~ "UK",
    TRUE ~ Country
  ))

cat("Downloading official data from Eurostat...\n")

# 1. Gini (ilc_di12)
gini_eu <- get_eurostat("ilc_di12", time_format = "num", stringsAsFactors = FALSE) %>%
  filter(geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, Gini_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# 2. ARPR (ilc_li02) - Corrected with dynamic column check
arpr_raw <- get_eurostat("ilc_li02", time_format = "num", stringsAsFactors = FALSE, update_cache = TRUE)

# Locate the indicator column (indic_il, indic_is, or indic_li)
indic_col_arpr <- intersect(c("indic_il", "indic_is", "indic_li", "indicator"), colnames(arpr_raw))[1]

if (!is.na(indic_col_arpr)) {
  arpr_eu <- arpr_raw %>% filter(!!sym(indic_col_arpr) == "LI_R_MD60")
} else {
  arpr_eu <- arpr_raw
}

arpr_eu <- arpr_eu %>%
  filter(sex == "T", age == "TOTAL", geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, ARPR_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# 3. S80/20 (ilc_di11)
s8020_eu <- get_eurostat("ilc_di11", time_format = "num", stringsAsFactors = FALSE) %>%
  filter(sex == "T", age == "TOTAL", geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, S8020_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# 4. Median Income (ilc_di03)
medinc_raw <- get_eurostat("ilc_di03", time_format = "num", stringsAsFactors = FALSE, update_cache = TRUE)

# Check if the column is named indic_il or indic_is
if ("indic_il" %in% colnames(medinc_raw)) {
  medinc_eu <- medinc_raw %>% filter(indic_il == "MED_E")
} else if ("indic_is" %in% colnames(medinc_raw)) {
  medinc_eu <- medinc_raw %>% filter(indic_is == "MED_E")
} else {
  # If Eurostat changed it completely, keep the whole dataset to inspect
  medinc_eu <- medinc_raw 
}

medinc_eu <- medinc_eu %>%
  filter(unit == "EUR", sex == "T", age == "TOTAL", geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, MedInc_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# 5. House Cost Overburden (ilc_lvho07a)
house_raw <- get_eurostat("ilc_lvho07a", time_format = "num", stringsAsFactors = FALSE, update_cache = TRUE)

# Check for the income group column (incgrp or quant_inc)
if ("incgrp" %in% colnames(house_raw)) {
  house_eu <- house_raw %>% filter(incgrp == "TOTAL")
} else if ("quant_inc" %in% colnames(house_raw)) {
  house_eu <- house_raw %>% filter(quant_inc == "TOTAL")
} else {
  house_eu <- house_raw
}

house_eu <- house_eu %>%
  filter(sex == "T", age == "TOTAL", geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, House_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# 6. Heat (ilc_mdes01) - Corrected with dynamic column checks
heat_raw <- get_eurostat("ilc_mdes01", time_format = "num", stringsAsFactors = FALSE, update_cache = TRUE)

# Locate available columns for household type and income
hhtyp_col <- intersect(c("hhtyp", "hhcomp", "household"), colnames(heat_raw))[1]
incgrp_col <- intersect(c("incgrp", "quant_inc"), colnames(heat_raw))[1]

heat_eu <- heat_raw

if (!is.na(hhtyp_col)) {
  heat_eu <- heat_eu %>% filter(!!sym(hhtyp_col) %in% c("TOTAL", "T"))
}
if (!is.na(incgrp_col)) {
  heat_eu <- heat_eu %>% filter(!!sym(incgrp_col) %in% c("TOTAL", "T"))
}

heat_eu <- heat_eu %>%
  filter(geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, Heat_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# 7. Low Work Intensity (ilc_lvhl11)
lwi_eu <- get_eurostat("ilc_lvhl11", time_format = "num", stringsAsFactors = FALSE) %>%
  filter(sex == "T", age == "Y_LT60", geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, LWI_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# 8. Lone Parent Households (ilc_lvph02)
lonep_raw <- get_eurostat("ilc_lvph02", time_format = "num", stringsAsFactors = FALSE, update_cache = TRUE)

# Check if the column is named hhtyp or household
if ("hhtyp" %in% colnames(lonep_raw)) {
  lonep_eu <- lonep_raw %>% filter(hhtyp == "A1_DCH")
} else if ("household" %in% colnames(lonep_raw)) {
  lonep_eu <- lonep_raw %>% filter(household == "A1_DCH")
} else {
  lonep_eu <- lonep_raw
}

lonep_eu <- lonep_eu %>%
  filter(geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, LoneP_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# 9. At-Risk-of-Poverty Threshold (ilc_li01) - Fully dynamic
arpt_raw <- get_eurostat("ilc_li01", time_format = "num", stringsAsFactors = FALSE, update_cache = TRUE)

arpt_eu <- arpt_raw

# 1. Dynamic check for the household column (hhtyp or household)
hhtyp_col_arpt <- intersect(c("hhtyp", "hhcomp", "household"), colnames(arpt_eu))[1]
if (!is.na(hhtyp_col_arpt)) {
  arpt_eu <- arpt_eu %>% filter(!!sym(hhtyp_col_arpt) == "A1")
}

# 2. Dynamic check for the currency column (currency or unit)
curr_col_arpt <- intersect(c("currency", "unit"), colnames(arpt_eu))[1]
if (!is.na(curr_col_arpt)) {
  arpt_eu <- arpt_eu %>% filter(!!sym(curr_col_arpt) == "EUR")
}

# 3. Dynamic check for the indicator column (indic_il, indic_is, etc.)
indic_col_arpt <- intersect(c("indic_il", "indic_is", "indic_li", "indicator"), colnames(arpt_eu))[1]
if (!is.na(indic_col_arpt)) {
  arpt_eu <- arpt_eu %>% filter(!!sym(indic_col_arpt) == "LI_C_MD60")
}

# 4. Final filtering of countries/years and column selection
arpt_eu <- arpt_eu %>%
  filter(geo %in% my_data$Country, TIME_PERIOD %in% my_data$Year) %>%
  select(Country = geo, Year = TIME_PERIOD, ARPT_EU = values) %>%
  distinct(Country, Year, .keep_all = TRUE)

# Merge all Eurostat data into a single chain
eurostat_data <- gini_eu %>%
  full_join(arpr_eu, by = c("Country", "Year")) %>%
  full_join(s8020_eu, by = c("Country", "Year")) %>%
  full_join(medinc_eu, by = c("Country", "Year")) %>%
  full_join(house_eu, by = c("Country", "Year")) %>%
  full_join(heat_eu, by = c("Country", "Year")) %>%
  full_join(lwi_eu, by = c("Country", "Year")) %>%
  full_join(lonep_eu, by = c("Country", "Year")) %>%
  full_join(arpt_eu, by = c("Country", "Year"))   # <--- ADDED ARPT

# Merge your custom data with Eurostat's
validation_df <- my_data %>%
  left_join(eurostat_data, by = c("Country", "Year")) %>%
  arrange(Country, Year)

# Create "Difference" columns (Absolute Error)
validation_df <- validation_df %>%
  mutate(
    Diff_Gini = round(abs(Gini - Gini_EU), 1),
    Diff_ARPR = round(abs(ARPR - ARPR_EU), 1),
    Diff_S8020 = round(abs(S8020 - S8020_EU), 2),
    Diff_MedInc = round(abs(MedInc - MedInc_EU), 0),
    Diff_House = round(abs(House - House_EU), 1),
    Diff_Heat = round(abs(Heat - Heat_EU), 1),
    Diff_LoneP = round(abs(LoneP - LoneP_EU), 1),
    Diff_ARPT = round(abs(ARPT - ARPT_EU), 0)      # <--- ADDED ARPT
  )

# Save the validation file
write.csv(validation_df, "Validation_vs_Eurostat_Final.csv", row.names = FALSE)

# Display Mean Deviation
cat("\n--- MEAN DEVIATION FROM OFFICIAL DATA (Mean Absolute Error) ---\n")
summary_errors <- validation_df %>%
  summarise(
    MAE_Gini   = mean(Diff_Gini, na.rm = TRUE),
    MAE_ARPR   = mean(Diff_ARPR, na.rm = TRUE),
    MAE_S8020  = mean(Diff_S8020, na.rm = TRUE),
    MAE_MedInc = mean(Diff_MedInc, na.rm = TRUE), # <--- ADDED
    MAE_House  = mean(Diff_House, na.rm = TRUE),
    MAE_Heat   = mean(Diff_Heat, na.rm = TRUE),
    MAE_LoneP  = mean(Diff_LoneP, na.rm = TRUE),
    MAE_ARPT   = mean(Diff_ARPT, na.rm = TRUE)
  )
print(summary_errors)
