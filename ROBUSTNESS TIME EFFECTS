# ==============================================================================
# ROBUSTNESS CHECK SCRIPT: Table A3 (Time & Country Fixed Effects)
# ==============================================================================

library(plm)
library(lmtest)
library(sandwich)
library(stargazer)

cat("\n========================================================\n")
cat("  ROBUSTNESS CHECK: TIME & COUNTRY FIXED EFFECTS (TWOWAYS)\n")
cat("========================================================\n")

# 1. Load the dataset (Relative path for full reproducibility)
raw_data <- read.csv2("Thesis_Final_Panel_Dataset_Bulletproof.csv", stringsAsFactors = FALSE)

numeric_cols <- c("MedInc", "ARPT", "ARPR", "Gini", "S8020", "LoneP", "LWI", "Unemp", "Tert", "House", "Heat", "Pens", "SocBen")
for(col in numeric_cols) {
  if(is.character(raw_data[[col]])) {
    raw_data[[col]] <- as.numeric(gsub(",", ".", raw_data[[col]]))
  }
}
pdata <- pdata.frame(raw_data, index = c("Country", "Year"))

# 2. ROBUSTNESS MODEL FOR GINI (Two-ways Fixed Effects)
fe_twoways_gini <- plm(Gini ~ lag(House, 1) + lag(Unemp, 1) + lag(SocBen, 1) + lag(Pens, 1) + 
                         lag(Tert, 1) + lag(LoneP, 1) + lag(Heat, 1) + lag(LWI, 1), 
                       data = pdata, model = "within", effect = "twoways")

# Arellano clustered standard errors
robust_gini_twoways <- coeftest(fe_twoways_gini, vcov = vcovHC(fe_twoways_gini, method = "arellano", cluster = "group"))

# 3. ROBUSTNESS MODEL FOR S80/20 (Two-ways Fixed Effects)
fe_twoways_s8020 <- plm(S8020 ~ lag(House, 1) + lag(Unemp, 1) + lag(SocBen, 1) + lag(Pens, 1) + 
                          lag(Tert, 1) + lag(LoneP, 1) + lag(Heat, 1) + lag(LWI, 1), 
                        data = pdata, model = "within", effect = "twoways")

# Arellano clustered standard errors
robust_s8020_twoways <- coeftest(fe_twoways_s8020, vcov = vcovHC(fe_twoways_s8020, method = "arellano", cluster = "group"))

# 4. Export Table A3 to Word using Stargazer
out_tableA3_file <- "TableA3_Robustness_Twoways.doc"

stargazer(fe_twoways_gini, fe_twoways_s8020,
          type = "html",
          out = out_tableA3_file,
          title = "Table A3: Robustness Check - Two-ways Fixed Effects (Country & Year)",
          column.labels = c("Gini Coefficient", "S80/S20 Ratio"),
          dep.var.labels.include = FALSE,
          se = list(robust_gini_twoways[,2], robust_s8020_twoways[,2]),
          p = list(robust_gini_twoways[,4], robust_s8020_twoways[,4]),
          covariate.labels = c("Housing Cost (t-1)", "Unemployment (t-1)", 
                               "Social Benefits (t-1)", "Pensions (t-1)", 
                               "Tertiary Edu. (t-1)", "Lone Parent (t-1)", 
                               "Heating Depr. (t-1)", "Low Work Int. (t-1)"),
          omit.stat = c("f", "ser"), 
          notes = "Notes: Arellano clustered standard errors in parentheses. Models include both country and year fixed effects to control for common macroeconomic shocks. *p < 0.10, **p < 0.05, ***p < 0.01.")

cat("\n--- DEPENDENT VARIABLE: Gini (Two-ways FE + Arellano SEs) ---\n")
print(robust_gini_twoways)

cat("\n--- DEPENDENT VARIABLE: S8020 (Two-ways FE + Arellano SEs) ---\n")
print(robust_s8020_twoways)

cat("\n--------------------------------------------------------\n")
cat(" SUCCESS: Table A3 successfully exported to:", out_tableA3_file, "\n")
cat("--------------------------------------------------------\n")